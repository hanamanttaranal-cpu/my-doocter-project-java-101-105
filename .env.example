# Server-side Gemini API key for Patient AI Health Assistant & Symptom Checker
GEMINI_API_KEY=

# MySQL / AWS RDS connection settings (used by Docker Compose & Spring Boot)
# For AWS RDS, set DATABASE_HOST to your RDS endpoint and DATABASE_USERNAME/DATABASE_PASSWORD in a local .env file
DATABASE_HOST=host.docker.internal
DATABASE_PORT=3306
DATABASE_NAME=mediconnect_db
DATABASE_USERNAME=root
DATABASE_PASSWORD=
