# Build stage
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Production stage
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Setup basic site configuration if needed (Nginx handles routing in compose)
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
